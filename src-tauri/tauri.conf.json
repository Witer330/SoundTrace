{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundTrace",
  "version": "0.2.0",
  "identifier": "com.soundtrace.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node tools/build-sidecar.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "声迹 SoundTrace",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/st-transcribe.exe",
      "binaries/st-diarize.exe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
